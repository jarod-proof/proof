{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxSize": "5GB",
  "cacheMaxAge": "3d",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "storybook-static/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    // A transit node (turbo docs: core-concepts/package-and-task-graph, configuring-tasks) that
    // carries the workspace dependency graph into each test task's hash. Without it a test hash
    // only sees its own package: editing packages/auth/src/access.ts left @proof/app#test
    // unchanged (probed with `turbo run test --dry-run=json`). Migrations, vitest config and
    // every other file a dependency's tests read are then inputs through the package graph.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    // Files the app tests read that no workspace dependency reaches (each needs its own input):
    // routeTree.gen.ts (static.test.ts), the registry record and the shipped skill (discovery and
    // skill-parity tests), and the CLI and SDK source that onboarding.test.ts runs as a process
    // (api-app does not depend on @proof/cli).
    "@proof/api-app#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/routeTree.gen.ts",
        "$TURBO_ROOT$/server.json",
        "$TURBO_ROOT$/skills/proof/SKILL.md",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/sdk/src/**"
      ]
    },
    "@proof/api-app#test:coverage": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/routeTree.gen.ts",
        "$TURBO_ROOT$/server.json",
        "$TURBO_ROOT$/skills/proof/SKILL.md",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/sdk/src/**"
      ],
      "outputs": ["coverage/**"]
    },
    // hq's spend tests include the daily cap's race, which needs real Postgres with real, separate
    // connections (spend.test.ts). They run when DATABASE_URL (a worktree's `*_wt_*` database) or
    // HQ_TEST_DATABASE_URL (a `*_test` database) is set, and skip otherwise. Turbo's strict env mode
    // hides both unless they are listed here, and listing them in `env` puts them in the task hash,
    // so a cached run from a shell without a database is never replayed as one with a database.
    "@proof/hq#test": {
      "dependsOn": ["transit"],
      "env": ["DATABASE_URL", "HQ_TEST_DATABASE_URL"]
    },
    "@proof/hq#test:coverage": {
      "dependsOn": ["transit"],
      "env": ["DATABASE_URL", "HQ_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    // shell.test.ts reads the prerendered shell (dist/index.html), so the web tests run after the
    // web build.
    "@proof/app#test": {
      "dependsOn": ["transit", "build"]
    },
    "@proof/app#test:coverage": {
      "dependsOn": ["transit", "build"],
      "outputs": ["coverage/**"]
    },
    // sdk's schema.test.ts checks the generated client against the API's committed contract. The
    // SDK does not depend on apps/api, so openapi.json is not in its graph.
    // apps/agent builds with `eve build` (through scripts/run.ts, which sets the inert placeholders
    // eve's compile needs, because turbo strips the environment): its output is .output.
    "@proof/agent#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "@proof/sdk#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json"]
    }
  }
}
