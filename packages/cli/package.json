{
  "name": "@proof/cli",
  "version": "0.0.0",
  "description": "Command-line client for the Proof API: sign in, list its operations and call them.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarod-proof/proof.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "proof": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "proof": "node dist/bin.js",
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/bin.js",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@proof/config": "workspace:*",
    "@proof/sdk": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.28.2",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
