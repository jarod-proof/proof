{
  "name": "@proof/auth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "generate": "better-auth generate --config ./auth.cli.ts --output ../db/src/auth-schema.ts -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@better-auth/api-key": "1.7.16",
    "@better-auth/cimd": "catalog:",
    "@better-auth/core": "1.7.16",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/scim": "1.7.16",
    "@better-auth/sso": "catalog:",
    "@better-auth/stripe": "catalog:",
    "@byo-oss/entitlements": "^0.4.0",
    "@byo-oss/notifications": "^0.14.0",
    "@byo-oss/core": "^0.2.0",
    "@byo-oss/mailer": "^0.2.0",
    "@byo-oss/support": "^0.5.0",
    "@proof/api": "workspace:*",
    "@proof/db": "workspace:*",
    "@proof/env": "workspace:*",
    "@proof/errors": "workspace:*",
    "@proof/logger": "workspace:*",
    "@proof/plans": "workspace:*",
    "@wraps.dev/better-auth": "^0.4.0",
    "@wraps.dev/email": "^0.15.1",
    "better-auth": "catalog:",
    "better-call": "1.4.5",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "stripe": "^23.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@proof/config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.16",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
