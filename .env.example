# Copy to .env (gitignored). mise loads it into your shell, so pnpm scripts, drizzle-kit and tests see it.
# Validated in packages/env — keep in sync.
DATABASE_URL=postgres://user:pass@localhost:5432/proof
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM="Proof <auth@example.com>"
# Auth emails go through SES via Wraps (us-east-1), with the AWS SDK's own credential chain. Locally,
# set AWS_PROFILE to an SSO profile whose account has EMAIL_FROM's domain verified, and leave
# DEV_MAIL_SINK unset. Read by the AWS SDK, not packages/env. See docs/auth.md, "Auth email locally".
# AWS_PROFILE=
# Optional: syncs signups to Wraps contacts
WRAPS_API_KEY=
# Optional: social sign-in. Each button appears only when both values are set. The callback URL is
# ${BETTER_AUTH_URL}/api/auth/callback/github (or /callback/google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: port for apps/api (defaults to the port in BETTER_AUTH_URL, then 3000).
# Under `pnpm dev`, portless sets PORT and PORTLESS_URL itself; apps/api then uses PORTLESS_URL as its URL.
PORT=
# Optional: fatal|error|warn|info|debug|trace|silent (default info; silent under test)
LOG_LEVEL=
# Requests per organization per UTC day while the owner has not verified their email (metering). Once
# claimed, the plan's limit applies (packages/plans/src/catalog.ts).
UNCLAIMED_ORG_DAILY_REQUEST_LIMIT=500
# Set to true only behind a proxy that overwrites X-Forwarded-For (signup rate limits use the client IP).
TRUST_PROXY=false
# Optional: vendors GET /status reports, from their own status pages (/health pings nothing). Comma-separated
# Name=https://status.example.com (an Atlassian Statuspage), Name=statusio:<page id> (status.io), or
# aws / aws@<region> / aws:<service>@<region> (AWS Health). Empty means the default: all of AWS,
# Cloudflare, Vercel, Neon and PlanetScale. Narrow it to what you use, e.g. aws:ses@us-east-1
STATUS_PROVIDERS=
# Optional: built web app to serve from this API origin (run `pnpm --filter @proof/app build` first).
WEB_DIST_DIR=
# Optional: origins the web app runs on when it is not the API's origin (comma-separated bare origins).
# Needed only then: auth callbacks (magic link, reset, social) and passkeys trust them. Under `pnpm dev` the web
# app is https://app.proof.localhost (portless.json); copy the URL portless prints. Leave empty in production, where apps/api serves the web app itself.
# e2e sets it to its web port.
WEB_ORIGINS=
# Dev only: where apps/app's vite dev server proxies API calls (default http://localhost:3000).
API_URL=
# apps/site build: the marketing site's own origin (canonical URLs, RSS) and the web app its
# "Sign in" and "Start free" link to. Defaults: http://localhost:4321 and the app's dev URL.
SITE_URL=
APP_URL=
# e2e only: model credential for `pnpm e2e` agent steps (Vercel AI Gateway). See e2e/README.md.
AI_GATEWAY_API_KEY=
# Dev and e2e only: keep auth emails in memory instead of sending them; GET /api/dev/mail?to=<address> reads them.
# Refused when NODE_ENV=production.
DEV_MAIL_SINK=
# Auth rate limits (sign-in, mail, one-time codes) by client IP. "off" is for dev and e2e only; refused
# unless NODE_ENV is development or test.
AUTH_RATE_LIMIT=on
# Optional: Stripe test mode. Both are needed for billing to mount; a live (sk_live_) key is refused at startup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: plans billing offers, as JSON, e.g. [{"name":"pro","priceId":"price_..."}] from your Stripe test dashboard.
STRIPE_PLANS=
# Optional: the organization that runs the product. Only its members, keys and agents may change
# feature flag rollouts (docs/feature-flags.md). Its id is in whoami.
OPERATOR_ORGANIZATION_ID=
# Optional: support thread mail (docs/support.md). Agent replies are mailed to the requester with
# Reply-To support+<token>@SUPPORT_REPLY_DOMAIN (a domain whose mail reaches inbound, below).
# Unset, nothing is mailed. SUPPORT_EMAIL_FROM is the sender, verified in SES; unset, EMAIL_FROM.
SUPPORT_REPLY_DOMAIN=
SUPPORT_EMAIL_FROM=
# Optional: inbound support mail from Wraps (SES to S3, an EventBridge event posted to
# /api/auth/support/inbound with X-Wraps-Inbound-Key). Needs SUPPORT_REPLY_DOMAIN. Unset, off.
# `wraps email inbound status --reveal-secret` prints the key and the bucket.
WRAPS_INBOUND_KEY=
WRAPS_INBOUND_BUCKET=
WRAPS_INBOUND_REGION=
# Optional: inbound support mail from another relay (Postmark, Mailgun, a Cloudflare Email Worker)
# that POSTs the raw message to /api/auth/support/inbound with Authorization: Bearer <secret>.
# Needs SUPPORT_REPLY_DOMAIN; not with WRAPS_INBOUND_KEY. openssl rand -base64 32
SUPPORT_INBOUND_SECRET=
# Optional: support's timing. The delay before an agent's reply is mailed (ms; unset, 2 minutes) and
# how often the API runs every BYO sweep: delayed mail, solved tickets, notification emails (ms; unset, a minute).
SUPPORT_REPLY_DELAY_MS=
SUPPORT_SWEEP_INTERVAL_MS=
# Optional: the file store for uploads (avatars, organization logos). Unset, uploads are off.
# local (a directory this API serves at /files; for dev and single-server setups), s3, r2 or vercel-blob.
# See docs/storage.md for each one's setup.
STORAGE_DRIVER=
# s3 and r2: the bucket.
STORAGE_BUCKET=
# Where files are read from (a CDN or custom domain). Required for r2 (its r2.dev URL or your domain);
# s3 defaults to the bucket URL, local to <API URL>/files.
STORAGE_PUBLIC_URL=
# local: the directory files go in (default .storage, git-ignored).
STORAGE_LOCAL_DIR=
# s3: an IAM user's keys with s3:PutObject and s3:DeleteObject on the bucket. S3_SESSION_TOKEN only for
# temporary credentials; S3_ENDPOINT only for an S3-compatible server (MinIO, LocalStack).
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ENDPOINT=
# r2: the Cloudflare account id and an R2 API token's S3 credentials (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# vercel-blob: the store's read-write token (Vercel sets it when you connect a Blob store to the project).
BLOB_READ_WRITE_TOKEN=
# Optional: where product analytics go: log (the API's log), posthog or none. Unset, it is log when
# NODE_ENV=development and none otherwise. See docs/analytics.md.
ANALYTICS_PROVIDER=
# posthog: the project API key (phc_...) and, for EU cloud or self-hosting, the ingestion host
# (default https://us.i.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=
