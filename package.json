{
  "name": "proof",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "portless",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "e2e run --target desktop,phone",
    "e2e:hq": "e2e run e2e/hq-smoke.e2e.ts e2e/hq-brain-api.e2e.ts e2e/hq-admin.e2e.ts --target hq",
    "e2e:slack": "e2e run e2e/slack-actions.e2e.ts --target slack",
    "hq:predeploy": "pnpm --filter @proof/hq predeploy",
    "baseline": "baseline scan .",
    "format": "biome format --write .",
    "test:coverage": "turbo run test:coverage",
    "format:check": "biome format .",
    "prepare": "lefthook install",
    "storybook": "pnpm --filter @proof/ui storybook",
    "stories": "node scripts/generate-stories.mjs",
    "wt": "node scripts/worktree.mjs",
    "flags": "pnpm --filter @proof/api-app exec tsx ../../scripts/flags.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@e2e-dev/web": "^0.15.2",
    "@gdp-ts/core": "catalog:",
    "@shadcn/lint": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "ai": "^7.0.130",
    "code-baseline": "^1.6.0",
    "e2e": "0.22.0",
    "lefthook": "^2.1.16",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "^0.15.7",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
