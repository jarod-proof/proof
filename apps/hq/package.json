{
  "name": "@proof/hq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc && tsc -p web/tsconfig.json",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-founder": "tsx src/create-founder.ts",
    "predeploy": "tsx src/predeploy.ts",
    "founders:principals": "tsx src/founder-principals.ts",
    "mint-agent-key": "tsx src/mint-agent-key.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@proof/api": "workspace:*",
    "@proof/auth": "workspace:*",
    "@proof/db": "workspace:*",
    "@proof/env": "workspace:*",
    "@proof/errors": "workspace:*",
    "@proof/logger": "workspace:*",
    "@proof/mcp": "workspace:*",
    "@proof/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.18",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@proof/config": "workspace:*",
    "@proof/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "cn": "catalog:",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
