---
import { SiteFooter } from "../components/site-footer"
import { SiteHeader } from "../components/site-header"
import { type NavId, site } from "../site"
import "../site.css"

interface Props {
  title: string
  description?: string
  active?: NavId
  announce?: boolean
}

const { title, description = site.description, active, announce = true } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light dark" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <script is:inline>
      // Before first paint, so a dark-mode visitor never sees the light page flash. The key and the
      // rule match apps/app/src/theme-boot.js ("proof.theme"): keep them in step. Storage is per
      // origin, so the app's choice carries over only when both are served from the same origin.
      ;(function () {
        try {
          let choice = "system"
          try {
            const stored = window.localStorage.getItem("proof.theme")
            if (stored === "light" || stored === "dark" || stored === "system") choice = stored
          } catch {
            // Storage blocked: follow the OS setting.
          }
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
          const dark = choice === "dark" || (choice === "system" && prefersDark)
          document.documentElement.classList.toggle("dark", dark)
        } catch {
          // No matchMedia: the page stays in light mode.
        }
      })()
    </script>
  </head>
  <body class="text-base leading-[1.55]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:ring-2 focus:ring-ring"
      >Skip to content</a
    >
    <SiteHeader active={active} announce={announce} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
